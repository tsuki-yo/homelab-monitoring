# Plausible analytics -- copy to .env and fill in real values, never commit .env itself
BASE_URL=https://your-plausible-domain.example
SECRET_KEY_BASE=  # generate: openssl rand -base64 64
POSTGRES_PASSWORD=  # pick a strong one, this is Plausible's own postgres instance

# DATABASE_URL's password must match POSTGRES_PASSWORD above exactly -- .env files
# don't support referencing other variables within themselves, so it has to be
# typed twice.
DATABASE_URL=postgres://postgres:<same-value-as-POSTGRES_PASSWORD-above>@plausible_db:5432/plausible_db
CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db
PORT=8000
